<!DOCTYPE html>
<html class="dark" lang="es">
  <head>
    <title>raul palacios</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Sr. Software Engineer based in Mexico City. 9+ years shipping production software, focused on LLM agents, MCP servers, and RAG systems. Tutorials and open-source.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= yield :head if content_for?(:head) %>
  </head>

  <body class="flex h-full flex-col bg-zinc-50 dark:bg-black">
    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>
    <%= yield %>
  </body>
</html>
